{
  "name": "@dpdpguard/react-native",
  "version": "2.0.0",
  "description": "DPDP Guard React Native SDK - typed HTTP client over the DPDP Guard /api/v1 surface, plus secure-element-backed offline consent capture",
  "main": "src/index",
  "files": [
    "src",
    "android",
    "ios",
    "DpdpGuardReactNative.podspec",
    "!src/**/*.test.ts",
    "!android/build",
    "!android/.gradle"
  ],
  "scripts": {
    "codegen": "node scripts/codegen.mjs",
    "test": "npm run codegen && jest",
    "typecheck": "npm run codegen && tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "author": "DPDP Guard",
  "license": "MIT",
  "homepage": "https://github.com/dpdp-guard-ai/dpdpguard-react-native-sdk#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/dpdp-guard-ai/dpdpguard-react-native-sdk"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "jest": "^29.7.0",
    "react": "^19.2.8",
    "react-native": "^0.85.3",
    "ts-jest": "^29.4.11",
    "typescript": "~5.8"
  },
  "dependencies": {
    "@dpdpguard/contract": "^1.6.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.85.0"
  },
  "codegenConfig": {
    "name": "DpdpGuardOfflineSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "ai.dpdpguard.offline"
    }
  }
}
