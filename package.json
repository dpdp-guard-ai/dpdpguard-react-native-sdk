{
  "name": "@dpdpguard/react-native",
  "version": "0.0.0",
  "description": "DPDP Guard React Native SDK - bridge over the native Android/iOS consent engines",
  "main": "src/index",
  "scripts": {
    "codegen": "node scripts/codegen.mjs",
    "postinstall": "node scripts/codegen.mjs",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "codegenConfig": {
    "name": "ReactNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.dpdpguard.reactnative"
    }
  },
  "author": " <> ()",
  "license": "MIT",
  "homepage": "#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "@react-native/babel-preset": "0.85.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.0",
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-native": "0.85.0",
    "ts-jest": "^29.4.11",
    "typescript": "~5.8"
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest",
      "lefthook",
      "release-it",
      "vite"
    ],
    "version": "0.63.0"
  },
  "dependencies": {
    "@dpdpguard/contract": "^0.2.0"
  }
}
